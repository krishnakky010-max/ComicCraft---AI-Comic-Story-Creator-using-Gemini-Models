# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Token (optional, for cloud Stable Diffusion inference)
HF_API_KEY=your_huggingface_api_key_here

# Set to 1 to enable local GPU Stable Diffusion pipeline via diffusers (requires CUDA GPU)
USE_DIFFUSERS=0
